# Production PHP Environment Configuration Template
# Copy this to .env.php and fill in your production values
# This file is deployed to the production PHP server (ynotradio.net)

# Auth0 (for admin authentication)
AUTH0_CLIENT_ID=your-client-id
AUTH0_DOMAIN=your-domain.auth0.com
AUTH0_CLIENT_SECRET=your-client-secret

# MySQL Database Connection (Primary data source)
DB_HOST=localhost
DB_NAME=ynotradio_site
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_PORT=3306

# PostgreSQL Connection (for feature flag testing)
POSTGRES_HOST=your-neon-host.neon.tech
POSTGRES_PORT=5432
POSTGRES_DATABASE=ynotradio
POSTGRES_USER=your-postgres-user
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_SSL_MODE=require

# Legacy PHP feature flags (optional)
USE_POSTGRES_TOP11=false
# Serve custom text pages from Postgres (default false = MySQL).
USE_POSTGRES_CUSTOMTEXT=false

# Media Storage (optional)
CLOUDINARY_CLOUD_NAME=your-cloud-name
