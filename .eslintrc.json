{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "project": "./tsconfig.json",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "settings": {
    "react": {
      "version": "detect"
    }
  },
  "extends": [
    "airbnb-base",
    "airbnb-typescript/base",
    "plugin:react/recommended",
    "plugin:react/jsx-runtime",
    "plugin:jsx-a11y/recommended",
    "next"
  ],
  "env": {
    "node": true
  },
  "ignorePatterns": [
    "build/",
    "node_modules/",
    "src/**/*.js",
    "src/**/*.php",
    "coverage/",
    "bin/check-test-story-files.ts"
  ],
  "rules": {
    "@typescript-eslint/semi": [
      "error",
      "always"
    ],
    "@typescript-eslint/comma-dangle": [
      "error",
      "always-multiline"
    ],
    "@typescript-eslint/indent": [
      "error",
      2
    ],
    "@typescript-eslint/object-curly-spacing": [
      "error",
      "always"
    ],
    "@typescript-eslint/consistent-type-assertions": [
      "error",
      {
        "assertionStyle": "as",
        "objectLiteralTypeAssertions": "never"
      }
    ],
    "import/extensions": [
      "error",
      "never",
      {
        "json": "always",
        "css": "always",
        "scss": "always",
        "less": "always"
      }
    ],
    "no-underscore-dangle": [
      "error",
      {
        "allow": [
          "_id",
          "_key",
          "_type",
          "_ref",
          "_status"
        ]
      }
    ],
    "import/prefer-default-export": "off",
    "import/no-extraneous-dependencies": [
      "error",
      {
        "devDependencies": true
      }
    ],
    "react/function-component-definition": [
      "error",
      {
        "namedComponents": "arrow-function"
      }
    ],
    "react/jsx-props-no-spreading": "off",
    "react/no-unescaped-entities": "off",
    "react-hooks/exhaustive-deps": "warn",
    "max-lines": [
      "warn",
      {
        "max": 300,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "complexity": [
      "warn",
      15
    ],
    "operator-linebreak": [
      "error",
      "before",
      {
        "overrides": {
          "=": "none"
        }
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/*.tsx"
      ],
      "env": {
        "browser": true
      },
      "rules": {
        "react/prop-types": "off"
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx"
      ],
      "rules": {
        "@typescript-eslint/consistent-type-assertions": "off",
        "object-curly-newline": "off",
        "import/order": "off",
        "@typescript-eslint/no-shadow": "off",
        "max-len": "off",
        "prefer-template": "off",
        "max-lines": "off",
        "@typescript-eslint/naming-convention": "off"
      }
    },
    {
      "files": [
        "bin/**/*.ts"
      ],
      "excludedFiles": [
        "**/*.test.ts"
      ],
      "rules": {
        "no-console": "off",
        "no-await-in-loop": "off",
        "no-restricted-syntax": "off",
        "no-plusplus": "off",
        "max-lines": "off",
        "complexity": "off"
      }
    },
    {
      "files": [
        "payload/src/collections/**/*.ts",
        "payload/src/components/**/*.tsx"
      ],
      "rules": {
        "max-lines": "off",
        "complexity": "off",
        "@next/next/no-img-element": "off"
      }
    },
    {
      "files": [
        "payload/src/features/**/*.tsx"
      ],
      "rules": {
        "@next/next/no-html-link-for-pages": "off"
      }
    },
    {
      "files": [
        "**/index.ts"
      ],
      "rules": {
        "no-restricted-syntax": [
          "error",
          {
            "selector": "ExportNamedDeclaration[source]",
            "message": "Barrel files (re-exporting from index.ts) are not allowed. Import directly from source modules."
          }
        ]
      }
    },
    {
      "files": [
        "app/(payload)/**/*.tsx"
      ],
      "rules": {
        "import/extensions": "off"
      }
    }
  ]
}
