# Preview Environment Configuration Template
# Copy this to .env.preview and fill in your values
# Used for Netlify preview/branch deployments and development Neon database

# Payload Core
PAYLOAD_SECRET=preview-secret-change-in-netlify
PAYLOAD_PUBLIC_SERVER_URL=https://preview--ynotradio.netlify.app
PORT=3000

# Development/Preview Neon PostgreSQL
# Use unpooled connection for migrations (no -pooler suffix)
DATABASE_URI=replace-with-dev-neon-connection
# Pooled connection for runtime (with -pooler suffix)
DATABASE_URI_POOLED=replace-with-dev-neon-pooled-connection
DATABASE_SSL=disable
NEON_DEV_DATABASE_URL=replace-with-dev-neon-connection

# Security
PAYLOAD_CORS=https://preview--ynotradio.netlify.app,http://localhost:3000
PAYLOAD_CSRF=https://preview--ynotradio.netlify.app
PAYLOAD_RATE_LIMIT=300

# Media Storage
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret

# Auth0
AUTH0_CLIENT_ID=replace-with-client-id
AUTH0_DOMAIN=replace-with-domain
AUTH0_CLIENT_SECRET=replace-with-client-secret

# Monitoring
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=
