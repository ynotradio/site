# Payload Core
PAYLOAD_SECRET=replace-with-dev-secret
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
PORT=3000

# Neon / PostgreSQL
DATABASE_URI=postgres://REPLACE_ME:REPLACE_ME@localhost:5432/ynot_payload_dev
DATABASE_SSL=disable
NEON_DEV_DATABASE_URL=postgres://REPLACE_ME:REPLACE_ME@ep-dev.neon.tech/neondb
NEON_PROD_DATABASE_URL=postgres://REPLACE_ME:REPLACE_ME@ep-prod.neon.tech/neondb

# Security
PAYLOAD_CORS=http://localhost:3000,http://localhost:5173
PAYLOAD_CSRF=http://localhost:3000
PAYLOAD_RATE_LIMIT=300

# Media Storage (switch to Cloudinary in production)
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret

# Monitoring
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=

# Legacy MySQL (for migration scripts)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=password
DB_NAME=ynot_site
