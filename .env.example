# Payload Core
PAYLOAD_SECRET=replace-with-dev-secret
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
PORT=3000

# Development Auto-Login (optional, for faster local development)
# These credentials will be pre-filled on the login page in development
# PAYLOAD_DEV_EMAIL=admin@ynotradio.net
# PAYLOAD_DEV_PASSWORD=password

# Neon / PostgreSQL
# IMPORTANT: For migrations to work, use UNPOOLED connection strings (remove "-pooler" from hostname)
# Pooled connections don't support setting search_path which is required for migrations
DATABASE_URI=postgres://REPLACE_ME:REPLACE_ME@ep-your-endpoint.neon.tech/ynotradio
DATABASE_SSL=disable
NEON_DEV_DATABASE_URL=postgres://REPLACE_ME:REPLACE_ME@ep-dev.neon.tech/ynotradio
NEON_PROD_DATABASE_URL=postgres://REPLACE_ME:REPLACE_ME@ep-prod.neon.tech/ynotradio

# PostgreSQL Connection for PHP (Direct Access)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=ynot_payload_dev
POSTGRES_USER=REPLACE_ME
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_SSL_MODE=disable

# Security
PAYLOAD_CORS=http://localhost:3000,http://localhost:5173
PAYLOAD_CSRF=http://localhost:3000
PAYLOAD_RATE_LIMIT=300

# Media Storage (switch to Cloudinary in production)
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret

# Monitoring
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=

# Legacy MySQL (for migration scripts)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=password
DB_NAME=ynot_site
