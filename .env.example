# Payload Core
PAYLOAD_SECRET=replace-with-dev-secret
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
PORT=3000

# Development Auto-Login (optional, for faster local development)
# These credentials will be pre-filled on the login page in development
# PAYLOAD_DEV_EMAIL=admin@ynotradio.net
# PAYLOAD_DEV_PASSWORD=password

# PostgreSQL / Netlify Database cutover
# DATABASE_URI remains the primary runtime/local development variable.
# IMPORTANT: For migrations to work, use UNPOOLED connection strings.
DATABASE_URI=postgres://ynot_postgres_user:dev_postgres_password_not_secret@localhost:5432/ynot_payload_dev
LOCAL_DATABASE_URL=postgres://ynot_postgres_user:dev_postgres_password_not_secret@localhost:5432/ynot_payload_dev
DATABASE_SSL=disable
PRODUCTION_DATABASE_URL=postgres://REPLACE_ME:REPLACE_ME@db-production.example/ynotradio
PREVIEW_DATABASE_URL=postgres://REPLACE_ME:REPLACE_ME@db-preview.example/ynotradio_preview

# Deprecated compatibility aliases during cutover
NEON_DEV_DATABASE_URL=postgres://REPLACE_ME:REPLACE_ME@ep-preview.neon.tech/ynotradio_preview
NEON_PROD_DATABASE_URL=postgres://REPLACE_ME:REPLACE_ME@ep-production.neon.tech/ynotradio

# PostgreSQL Connection for PHP (Direct Access)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=ynot_payload_dev
POSTGRES_USER=REPLACE_ME
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_SSL_MODE=disable

# Security
PAYLOAD_CORS=http://localhost:3000,http://localhost:5173
PAYLOAD_CSRF=http://localhost:3000
PAYLOAD_RATE_LIMIT=300

# Media Storage (switch to Cloudinary in production)
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret

# Monitoring
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=

# Legacy MySQL Configuration
# Docker PHP containers use DB_HOST pointing to 'mysql' service name (for Docker network)
# Import scripts use IMPORT_DB_HOST pointing to 'localhost' for exposed port access
# When running locally, both can use the same credentials

# For Docker PHP site (inside container)
DB_HOST=mysql
DB_USER=ynot_sql_user
DB_PASSWORD=ynot_sql_pass
DB_NAME=ynot_site
DB_PORT=3306

# For import scripts running on host machine (connecting via exposed port)
IMPORT_DB_HOST=localhost
IMPORT_DB_PORT=3306
IMPORT_DB_NAME=ynot_site
IMPORT_DB_USER=ynot_sql_user
IMPORT_DB_PASSWORD=ynot_sql_pass
