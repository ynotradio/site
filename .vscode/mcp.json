{
    "servers": {
        "mcp_server_mysql": {
            "command": "npx",
            "args": [
                "-y",
                "@benborla29/mcp-server-mysql"
            ],
            "env": {
                "MYSQL_HOST": "127.0.0.1",
                "MYSQL_PORT": "3306",
                "MYSQL_USER": "ynot_sql_user",
                "MYSQL_PASS": "ynot_sql_pass",
                "MYSQL_DB": "ynot_site"
            }
        },
        "chrome-devtools": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-chrome-devtools"
            ]
        }
    }
}
