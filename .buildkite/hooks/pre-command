#!/bin/bash
# .buildkite/hooks/pre-command
# Runs before each command in a step.
# Secrets are scoped by pipeline to follow the principle of least privilege.

set -euo pipefail

# --- GHCR login (needed by CI and build-images pipelines) ---
GHCR_USERNAME=$(buildkite-agent secret get GHCR_USERNAME 2>/dev/null || true)
GHCR_TOKEN=$(buildkite-agent secret get GHCR_TOKEN 2>/dev/null || true)

if [[ -n "$GHCR_TOKEN" && -n "$GHCR_USERNAME" ]]; then
  echo "--- :docker: Logging into GHCR"
  echo "$GHCR_TOKEN" | docker login ghcr.io -u "$GHCR_USERNAME" --password-stdin
  echo "✅ Logged into GHCR"
else
  echo "⚠️ GHCR credentials not found, skipping login"
fi

# --- Storybook / PR comment tokens (only for CI pipeline) ---
if [[ "${BUILDKITE_PIPELINE_SLUG:-}" == *"ci"* ]] || [[ "${BUILDKITE_PIPELINE_SLUG:-}" == *"site"* ]]; then
  NETLIFY_AUTH_TOKEN=$(buildkite-agent secret get NETLIFY_AUTH_TOKEN 2>/dev/null || true)
  GITHUB_PR_TOKEN=$(buildkite-agent secret get GITHUB_PR_TOKEN 2>/dev/null || true)
  export NETLIFY_AUTH_TOKEN GITHUB_PR_TOKEN
fi

# --- Production / preview database credentials (only for nightly and db-sync pipelines) ---
if [[ "${BUILDKITE_PIPELINE_SLUG:-}" == *"nightly"* ]] || [[ "${BUILDKITE_PIPELINE_SLUG:-}" == *"gap-report"* ]] || [[ "${BUILDKITE_PIPELINE_SLUG:-}" == *"db-sync"* ]]; then
  PROD_MYSQL_HOST=$(buildkite-agent secret get PROD_MYSQL_HOST 2>/dev/null || true)
  PROD_MYSQL_USER=$(buildkite-agent secret get PROD_MYSQL_USER 2>/dev/null || true)
  PROD_MYSQL_PASSWORD=$(buildkite-agent secret get PROD_MYSQL_PASSWORD 2>/dev/null || true)
  PROD_MYSQL_DATABASE=$(buildkite-agent secret get PROD_MYSQL_DATABASE 2>/dev/null || true)
  PRODUCTION_DATABASE_URL=$(buildkite-agent secret get PRODUCTION_DATABASE_URL 2>/dev/null || true)
  PREVIEW_DATABASE_URL=$(buildkite-agent secret get PREVIEW_DATABASE_URL 2>/dev/null || true)
  NEON_PROD_DATABASE_URL=$(buildkite-agent secret get NEON_PROD_DATABASE_URL 2>/dev/null || true)
  NEON_DEV_DATABASE_URL=$(buildkite-agent secret get NEON_DEV_DATABASE_URL 2>/dev/null || true)

  resolved_production_database_url="${PRODUCTION_DATABASE_URL:-$NEON_PROD_DATABASE_URL}"
  resolved_preview_database_url="${PREVIEW_DATABASE_URL:-$NEON_DEV_DATABASE_URL}"

  if [[ -z "$resolved_production_database_url" ]] || [[ -z "$resolved_preview_database_url" ]]; then
    echo "❌ PRODUCTION_DATABASE_URL and PREVIEW_DATABASE_URL must be configured for nightly/db-sync pipelines"
    exit 1
  fi

  PRODUCTION_DATABASE_URL="$resolved_production_database_url"
  PREVIEW_DATABASE_URL="$resolved_preview_database_url"

  # Temporary compatibility aliases during cutover.
  if [[ -z "$NEON_PROD_DATABASE_URL" ]]; then
    NEON_PROD_DATABASE_URL="$PRODUCTION_DATABASE_URL"
  fi

  if [[ -z "$NEON_DEV_DATABASE_URL" ]]; then
    NEON_DEV_DATABASE_URL="$PREVIEW_DATABASE_URL"
  fi

  GITHUB_PR_TOKEN=$(buildkite-agent secret get GITHUB_PR_TOKEN 2>/dev/null || true)
  GAP_REPORT_ISSUE_NUMBER=$(buildkite-agent secret get GAP_REPORT_ISSUE_NUMBER 2>/dev/null || true)
  INTEGRITY_REPORT_ISSUE_NUMBER=$(buildkite-agent secret get INTEGRITY_REPORT_ISSUE_NUMBER 2>/dev/null || true)
  export PROD_MYSQL_HOST PROD_MYSQL_USER PROD_MYSQL_PASSWORD PROD_MYSQL_DATABASE
  export PRODUCTION_DATABASE_URL PREVIEW_DATABASE_URL
  export NEON_PROD_DATABASE_URL NEON_DEV_DATABASE_URL GITHUB_PR_TOKEN GAP_REPORT_ISSUE_NUMBER
  export INTEGRITY_REPORT_ISSUE_NUMBER
fi

# --- Legacy PHP deploy secrets (only for the legacy + PR deploy pipelines) ---
# Fetched here on the agent host so they're available inside the docker
# plugin's container via propagate-environment. The new `buildkite-agent
# secret get` API needs the per-job Unix socket which isn't mounted into
# plugin containers, so it can't run inside docker.
if [[ "${BUILDKITE_PIPELINE_SLUG:-}" == *"deploy"* ]] || [[ "${BUILDKITE_STEP_KEY:-}" == *"deploy"* ]]; then
  DEPLOY_SSH_KEY=$(buildkite-agent secret get DEPLOY_SSH_KEY 2>/dev/null || true)
  DEPLOY_SSH_KNOWN_HOSTS=$(buildkite-agent secret get DEPLOY_SSH_KNOWN_HOSTS 2>/dev/null || true)
  DEPLOY_SSH_HOST=$(buildkite-agent secret get DEPLOY_SSH_HOST 2>/dev/null || true)
  ENV_PHP_CONTENTS=$(buildkite-agent secret get ENV_PHP_CONTENTS 2>/dev/null || true)
  export DEPLOY_SSH_KEY DEPLOY_SSH_KNOWN_HOSTS DEPLOY_SSH_HOST ENV_PHP_CONTENTS
fi

# --- E2E environment setup ---
if [[ -f "./bin/setup-e2e-env.sh" ]]; then
  echo "--- Setting up E2E environment"
  ./bin/setup-e2e-env.sh
fi
