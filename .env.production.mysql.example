# Production MySQL Configuration (Read-Only Access)
#
# Copy this file to .env.production.mysql and fill in your production credentials.
# This file is used by import scripts to read data from production MySQL
# and import it into the configured production PostgreSQL database.
#
# IMPORTANT: These credentials should be READ-ONLY access to production MySQL.
# The import scripts never write to production MySQL.

# Production MySQL Server
PROD_MYSQL_HOST=your-production-mysql-hostname.amazonaws.com
PROD_MYSQL_PORT=3306
PROD_MYSQL_DATABASE=ynot_site
PROD_MYSQL_USER=readonly_user
PROD_MYSQL_PASSWORD=your-secure-password

# Usage:
#   yarn import:incremental --from prod-mysql --to prod-neon
#
# This reads from production MySQL (using these credentials)
# and writes to the configured production PostgreSQL target
# (using PRODUCTION_DATABASE_URL, with NEON_PROD_DATABASE_URL as a temporary fallback)
