# Production Environment Configuration Template
# Copy this to .env.production and fill in your values
# Used for Netlify production deployments and production Neon database

# Payload Core
PAYLOAD_SECRET=replace-with-production-secret-in-netlify
PAYLOAD_PUBLIC_SERVER_URL=https://www.ynotradio.net
PORT=3000

# Production PostgreSQL / Netlify Database
# Use unpooled connection for migrations (no -pooler suffix)
DATABASE_URI=replace-with-production-database-connection
# Pooled connection for runtime (with -pooler suffix, if supported)
DATABASE_URI_POOLED=replace-with-production-pooled-connection
DATABASE_SSL=disable
PRODUCTION_DATABASE_URL=replace-with-production-database-connection

# Deprecated compatibility alias during cutover
NEON_PROD_DATABASE_URL=replace-with-production-database-connection

# Security
PAYLOAD_CORS=https://www.ynotradio.net
PAYLOAD_CSRF=https://www.ynotradio.net
PAYLOAD_RATE_LIMIT=300

# Media Storage
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret

# Auth0
AUTH0_CLIENT_ID=replace-with-client-id
AUTH0_DOMAIN=replace-with-domain
AUTH0_CLIENT_SECRET=replace-with-client-secret

# Monitoring (set in Netlify)
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=
