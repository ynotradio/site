# E2E Test Environment Variables
# These are LOCAL DEVELOPMENT ONLY credentials - not used in production

# Database credentials (dev only, not secrets)
POSTGRES_USER=ynot_postgres_user
POSTGRES_PASSWORD=dev_postgres_password_not_secret
POSTGRES_DB=ynot_payload_dev

MYSQL_ROOT_PASSWORD=dev_root_password_not_secret
MYSQL_USER=ynot_sql_user
MYSQL_PASSWORD=dev_mysql_password_not_secret
MYSQL_DATABASE=ynot_site

# Pre-built images (leave empty to build locally)
# PAYLOAD_IMAGE=ghcr.io/ynotradio/site/payload-dev:latest
# PHPFPM_IMAGE=ghcr.io/ynotradio/site/phpfpm-dev:latest
# PLAYWRIGHT_IMAGE=ghcr.io/ynotradio/site/playwright:latest
# POSTGRES_IMAGE=ghcr.io/ynotradio/site/postgres-seeded:latest

# Default images (used when pre-built not available)
PAYLOAD_IMAGE=node:22-slim
PHPFPM_IMAGE=php:7.4-fpm
PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.58.2-noble
POSTGRES_IMAGE=postgres:16-alpine
