    /**
     * Get the next match
     * 
     * @return array The next match data (empty array if none)
     */
    public function getNextMatch(): array
    {
        $current_match = $this->getCurrentMatch();
        if (empty($current_match)) {
            return array();
        }

        $query = "SELECT * FROM mrm_matches WHERE id > " . $current_match['id'] . " AND band1_id != 0 AND band2_id != 0 ORDER BY id ASC LIMIT 1";
        $result = mysqli_query($this->db, $query);

        if (!$result || mysqli_num_rows($result) === 0) {
            return array();
        }

        return mysqli_fetch_assoc($result);
    }

    /**
     * Check if waiting for the final match
     * 
     * @return bool Whether waiting for the final match
     */
    public function waitingForFinal(): bool
    {
        $current_match = $this->getCurrentMatch();
        
        if (empty($current_match)) {
            return false;
        }
        
        return ($current_match['id'] == 63);
    }

    /**
     * Check if the tournament is over
     * 
     * @return bool Whether the tournament is over
     */
    public function endOfMadness(): bool
    {
        $query = "SELECT * FROM mrm_matches WHERE id = 63 AND winner_id != 0";
        $result = mysqli_query($this->db, $query);
        
        return ($result && mysqli_num_rows($result) > 0);
    }

    /**
     * Get all bands
     * 
     * @return array All bands in the tournament
     */
    public function getAllBands(): array
    {
        $query = "SELECT * FROM mrm_bands ORDER BY id ASC";
        $result = mysqli_query($this->db, $query);

        if (!$result) {
            return array();
        }

        $bands = array();
        while ($band = mysqli_fetch_assoc($result)) {
            $bands[] = $band;
        }

        return $bands;
    }

