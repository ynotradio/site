     * @return string The band abbreviation
     */
    public function getBandAbbr(int $id): string
    {
        $query = "SELECT abbr FROM mrm_bands where placement=" . $id;
        $result = mysqli_query($this->db, $query);

        if (!$result || mysqli_num_rows($result) === 0) {
