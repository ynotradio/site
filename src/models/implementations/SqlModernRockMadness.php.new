    /**
     * Update a band's information
     * 
     * @param int $id The band ID
     * @param string $name The band name
     * @param string $url The band URL
     * @param string $pic_url The band picture URL
     * @param string $placement The band's placement in the bracket
     * @param string $seed The band's seed number
     * @param string $abbr The band name abbreviation
     * @param string $sponsor The band's sponsor
     * @return bool Whether the update was successful
     */
    public function updateBand(int $id, string $name, string $url, string $pic_url, string $placement, string $seed, string $abbr, string $sponsor): bool
    {
        $name = mysqli_real_escape_string($this->db, $name);
        $url = mysqli_real_escape_string($this->db, $url);
        $pic_url = mysqli_real_escape_string($this->db, $pic_url);
        $placement = mysqli_real_escape_string($this->db, $placement);
        $seed = mysqli_real_escape_string($this->db, $seed);
        $abbr = mysqli_real_escape_string($this->db, $abbr);
        $sponsor = mysqli_real_escape_string($this->db, $sponsor);

        $update = "UPDATE mrm_bands SET name=\"$name\", url=\"$url\", pic_url=\"$pic_url\", placement=\"$placement\", seed=\"$seed\", abbr=\"$abbr\", sponsor=\"$sponsor\" WHERE id=" . $id;
        $result = mysqli_query($this->db, $update);

        return $result ? true : false;
    }

    /**
     * Update a match sponsor
     * 
     * @param int $match The match ID
     * @param string $sponsor The sponsor name
     * @param string $sponsor_msg The sponsor message
     * @return bool Whether the update was successful
     */
    public function updateSponsor(int $match, string $sponsor, string $sponsor_msg): bool
    {
        $sponsor = mysqli_real_escape_string($this->db, $sponsor);
        $sponsor_msg = mysqli_real_escape_string($this->db, $sponsor_msg);

        $update = "UPDATE mrm_matches SET sponsor=\"$sponsor\", sponsor_msg=\"$sponsor_msg\" WHERE id=" . $match;
        $result = mysqli_query($this->db, $update);

        return $result ? true : false;
    }

    /**
     * Calculate the vote percentage for display
     * 
     * @param int $val1 First vote count
     * @param int $val2 Second vote count
     * @param string $display Display mode ('none' or any other value)
     * @return string Formatted percentage
     */
    public function votePercentage(int $val1, int $val2, string $display = 'none'): string
    {
        if ($val1 == 0 && $val2 == 0) {
            if ($display == 'none') {
                return "";
            } else {
                return "50%";
            }
        } else {
            return round((($val1 / ($val1 + $val2)) * 100), 0) . '%';
        }
    }

    /**
     * Get tournament dates based on start date
     * 
     * @param string $start_date The tournament start date
     * @return array Tournament dates for each round
     */
    public function getTournamentDates(string $start_date): array
    {
        // Parse the start date
        $tournament_start = strtotime($start_date);
        
        // Ensure the start date is a Monday (1 = Monday, 7 = Sunday)
        $day_of_week = date('N', $tournament_start);
        if ($day_of_week != 1) {
            // Adjust to next Monday if not already a Monday
            $tournament_start = strtotime('next Monday', $tournament_start);
        }
        
        // Calculate all tournament dates
        $dates = array();
        
        // First Round - Left side (Monday-Tuesday of Week 1)
        $first_round_left_start = $tournament_start;
        $first_round_left_end = strtotime('+1 day', $first_round_left_start);
        $dates['first_round_left'] = date('F j', $first_round_left_start) . '-' . date('j', $first_round_left_end);
        
        // First Round - Right side (Wednesday-Thursday of Week 1)
        $first_round_right_start = strtotime('+2 days', $first_round_left_start);
        $first_round_right_end = strtotime('+1 day', $first_round_right_start);
        $dates['first_round_right'] = date('F j', $first_round_right_start) . '-' . date('j', $first_round_right_end);
        
        // Second Round - Left side (Monday of Week 2)
        $second_round_left = strtotime('+7 days', $first_round_left_start);
        $dates['second_round_left'] = date('F j', $second_round_left);
        
        // Second Round - Right side (Tuesday of Week 2)
        $second_round_right = strtotime('+1 day', $second_round_left);
        $dates['second_round_right'] = date('F j', $second_round_right);
        
        // Sweet 16 (Wednesday of Week 2)
        $sweet_16 = strtotime('+2 days', $second_round_left);
        $dates['sweet_16'] = date('F j', $sweet_16);
        
        // Elite 8 (Thursday of Week 2)
        $elusive_8 = strtotime('+1 day', $sweet_16);
        $dates['elusive_8'] = date('F j', $elusive_8);
        
        // Final Four (Friday of Week 2)
        $final_4 = strtotime('+1 day', $elusive_8);
        $dates['final_4'] = date('F j', $final_4);
        
        // Championship (Monday of Week 3)
        $championship = strtotime('+3 days', $final_4);
        $dates['championship'] = date('F j', $championship);
        
        return $dates;
    }

    /**
     * Format a timeline item for display
     * 
     * @param string $title The timeline item title
     * @param string $date The timeline item date
     * @param bool $use_padding Whether to add padding
     * @return string Formatted HTML for the timeline item
     */
    public function formatTimelineItem(string $title, string $date, bool $use_padding = false): string
    {
        $padding_class = $use_padding ? ' class="top-pad_3"' : '';
        return "<li{$padding_class}><strong>{$title}</strong>{$date}</li>\n";
    }

    /**
     * Display the first row of the tournament bracket
     * 
     * @param string $start_date Optional tournament start date
     * @return string HTML for the first row
     */
    public function displayFirstRow(string $start_date = null): string
    {
        // Default to current year March 17th if no date provided
        if ($start_date === null) {
            $start_date = date('Y') . '-03-17';
        }
        
        // Get all tournament dates
        $dates = $this->getTournamentDates($start_date);
        
        // Build the timeline HTML
        $output = "<ul id='time_line'>\n";
        
        // Left side of the bracket (first to championship)
        $output .= $this->formatTimelineItem("1<sup>st</sup> ROUND", $dates['first_round_left']);
        $output .= $this->formatTimelineItem("2<sup>nd</sup> ROUND", $dates['second_round_left']);
        $output .= $this->formatTimelineItem("SWELL 16", $dates['sweet_16'], true);
        $output .= $this->formatTimelineItem("ELUSIVE 8", $dates['elusive_8'], true);
        $output .= $this->formatTimelineItem("FANTASTIC 4", $dates['final_4'], true);
        
        // Championship (center)
        $output .= $this->formatTimelineItem("CHAMPION", $dates['championship'], true);
        
        // Right side of the bracket (championship to first)
        $output .= $this->formatTimelineItem("FANTASTIC 4", $dates['final_4'], true);
        $output .= $this->formatTimelineItem("ELUSIVE 8", $dates['elusive_8'], true);
        $output .= $this->formatTimelineItem("SWELL 16", $dates['sweet_16'], true);
        $output .= $this->formatTimelineItem("2<sup>nd</sup> ROUND", $dates['second_round_right']);
        $output .= $this->formatTimelineItem("1<sup>st</sup> ROUND", $dates['first_round_right']);
        
        // Close the timeline
        $output .= "</ul>\n";
        
        return $output;
    }

    /**
     * Get countdown values for a match
     * 
     * @param int $match_id The match ID
     * @return array Countdown values (hours, minutes, seconds)
     */
    public function getCountdownValues(int $match_id): array
    {
        $match = $this->getMatchById($match_id);
        if (empty($match)) {
            return array("hr" => "0", "min" => "0", "sec" => "0");
        }

        $current_time = $this->getCurrentTime();
        $end_time = $match['end_time'];
        
        $time_diff = strtotime($end_time) - strtotime($current_time);
        
        if ($time_diff <= 0) {
            return array("hr" => "0", "min" => "0", "sec" => "0");
        }
        
        $hours = floor($time_diff / 3600);
        $minutes = floor(($time_diff % 3600) / 60);
        $seconds = $time_diff % 60;
        
        return array(
            "hr" => (string)$hours,
            "min" => (string)$minutes,
            "sec" => (string)$seconds
        );
    }

    /**
     * Get a match by its ID
     * 
     * @param int $id The match ID
     * @return array The match data (empty array if not found)
     */
    public function getMatchById(int $id): array
    {
        $query = "SELECT * FROM mrm_matches where id=" . $id;
        $result = mysqli_query($this->db, $query);

        if (!$result || mysqli_num_rows($result) === 0) {
            return array();
        }
        return mysqli_fetch_assoc($result);
    }

    /**
     * Get the current match
     * 
     * @return array The current match data (empty array if none)
     */
    public function getCurrentMatch(): array
    {
        $current_time = $this->getCurrentTime();
        
        $query = "SELECT * FROM mrm_matches WHERE band1_id != 0 AND band2_id != 0 AND winner_id = 0 AND start_time <= '" . $current_time . "' AND end_time >= '" . $current_time . "' LIMIT 1";
        $result = mysqli_query($this->db, $query);
        
        if (!$result || mysqli_num_rows($result) === 0) {
            // Check if any matches are upcoming
            $query = "SELECT * FROM mrm_matches WHERE band1_id != 0 AND band2_id != 0 AND winner_id = 0 AND start_time > '" . $current_time . "' ORDER BY start_time ASC LIMIT 1";
            $result = mysqli_query($this->db, $query);
            
            if (!$result || mysqli_num_rows($result) === 0) {
                // Check if any matches have ended
                $query = "SELECT * FROM mrm_matches WHERE band1_id != 0 AND band2_id != 0 AND end_time < '" . $current_time . "' ORDER BY end_time DESC LIMIT 1";
                $result = mysqli_query($this->db, $query);
                
                if (!$result || mysqli_num_rows($result) === 0) {
                    // Special case for 'ready' match (ID 8888)
                    $query = "SELECT * FROM mrm_matches WHERE id = 8888 LIMIT 1";
                    $result = mysqli_query($this->db, $query);
                    
                    if (!$result || mysqli_num_rows($result) === 0) {
                        return array();
                    }
                }
            }
        }
        
        return mysqli_fetch_assoc($result);
    }

    /**
     * Get a match's status
     * 
     * @param int $match_id The match ID
     * @return string The match status ('early', 'running', 'over', 'invalid')
     */
    public function getMatchStatus(int $match_id): string
    {
        $match = $this->getMatchById($match_id);
        if (empty($match)) {
            return "invalid";
        }
        
        $current_time = $this->getCurrentTime();
        
        if (strtotime($match['start_time']) > strtotime($current_time)) {
            return "early";
        } elseif (strtotime($match['end_time']) < strtotime($current_time)) {
            return "over";
        } else {
            return "running";
        }
    }

    /**
     * Check if a match is tied
     * 
     * @param array $match The match data
     * @return bool Whether the match is tied
     */
    public function matchIsTied(array $match): bool
    {
        return ($match['band1_votes'] == $match['band2_votes']);
    }

    /**
     * Check if a match is closed
     * 
     * @param int $match_id The match ID
     * @return bool Whether the match is closed
     */
    public function isMatchClosed(int $match_id): bool
    {
        $match = $this->getMatchById($match_id);
        if (empty($match)) {
            return false;
        }

        return ($match['winner_id'] != 0);
    }

    /**
     * Get the current time
     * 
     * @return string The current time in Y-m-d H:i:s format
     */
    public function getCurrentTime(): string
    {
        return date("Y-m-d H:i:s", time());
    }

    /**
     * Close a match
     * 
     * @param int $match_id The match ID
     * @param int $round The tournament round
     * @return bool Whether the match was closed successfully
     */
    public function closeMatch(int $match_id, int $round): bool
    {
        $winner_id = $this->setWinner($match_id);
        $this->enableScore($match_id);

        if ($match_id < 63) {
            $this->setupNextMatch($match_id, $winner_id);
        }

        return true;
    }

    /**
     * Enable score display for a match
     * 
     * @param int $match_id The match ID
     * @return bool Whether the score was enabled successfully
     */
    public function enableScore(int $match_id): bool
    {
        $update = "UPDATE mrm_matches SET show_score = true WHERE id =" . $match_id;
        $result = mysqli_query($this->db, $update);

        return $result ? true : false;
    }

    /**
     * Set the winner for a match
     * 
     * @param int $match_id The match ID
     * @return int The ID of the winner
     */
    public function setWinner(int $match_id): int
    {
        $match = $this->getMatchById($match_id);
        if (empty($match)) {
            return 0;
        }

        $winner = ($match['band1_votes'] > $match['band2_votes']) ? $match['band1_id'] : $match['band2_id'];

        $update = "UPDATE mrm_matches SET winner_id=\"" . $winner . "\" WHERE id=" . $match_id;
        $result = mysqli_query($this->db, $update);

        if (!$result) {
            error_log("Error Updating Winner: " . mysqli_error($this->db));
            error_log("Query: " . $update);
            return 0;
        }
        
        return $winner;
    }

    /**
     * Setup the next match after a match is completed
     * 
     * @param int $last_match_id The completed match ID
     * @param int $winner_id The winner ID
     * @return bool Whether the setup was successful
     */
    public function setupNextMatch(int $last_match_id, int $winner_id): bool
    {
        $new_match = $this->getNewMatch($last_match_id);
        if ($new_match === 0) {
            return false;
        }
        
        // 0 = even, 1 = odd - determines band1_id or band2_id position
        $band_value = $last_match_id & 1;

        if ($band_value == 1) {
            $update = "UPDATE mrm_matches SET band1_id=\"$winner_id\" WHERE id=" . $new_match;
        } else {
            $update = "UPDATE mrm_matches SET band2_id=\"$winner_id\" WHERE id=" . $new_match;
        }

        $result = mysqli_query($this->db, $update);
        return $result ? true : false;
    }

    /**
     * Get the new match ID based on an old match ID
     * 
     * @param int $old_match The old match ID
     * @return int The new match ID
     */
    public function getNewMatch(int $old_match): int
    {
        $query = "SELECT * FROM mrm_matches_flow WHERE old =" . $old_match;
        $result = mysqli_query($this->db, $query);

        if (!$result || mysqli_num_rows($result) === 0) {
            return 0;
        }
        
        $info = mysqli_fetch_assoc($result);
        return (int)$info['new'];
    }

    /**
     * Get the CSS class for a winner
     * 
     * @param int $band_id The band ID
     * @param int $match_id The match ID
     * @return string The CSS class
     */
    public function getWinnerClass(int $band_id, int $match_id): string
    {
        $match = $this->getMatchById($match_id);
        if (empty($match)) {
            return '';
        }
        
        if ($match['winner_id'] === 0) {
            return '';
        }
        
        return ($match['winner_id'] == $band_id) ? 'mrm_winner' : 'mrm_loser';
    }

