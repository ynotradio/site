# Authentication
AUTH0_DOMAIN=your-auth0-domain.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret

# Database Connection
DB_NAME=ynot_site
DB_USER=ynot_sql_user
DB_PASSWORD=ynot_sql_pass
DB_HOST=mysql

# Feature Flags (Optional)
# Set to 'true', '1', 'yes', or 'on' to enable Postgres mode for specific features
# These override the defaults in src/config/features.php
# USE_POSTGRES_CONCERTS=false
# USE_POSTGRES_ONDEMAND=false
# USE_POSTGRES_DEEJAYS=false
# USE_POSTGRES_MUSIC=false
# USE_POSTGRES_STORIES=false
# USE_POSTGRES_CDOFTHEWEEK=false
# USE_POSTGRES_SCHEDULE=false
# USE_POSTGRES_CUSTOMTEXT=false