{
  "require": {
    "php": "^8.3",
    "auth0/auth0-php": "~7.0",
    "vlucas/phpdotenv": "^5.3"
  },
  "config": {
    "platform": {
      "php": "8.3.36"
    }
  },
  "scripts": {
    "deploy": "cd .. && ./bin/deploy.sh",
    "rollback": "cd .. && ./bin/rollback.sh"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.7",
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "YNotRadio\\": ""
    },
    "classmap": [
      "models/",
      "controllers/",
      "config/",
      "functions/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "YNotRadio\\Tests\\": "tests/"
    }
  }
}
