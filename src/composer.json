{
    "require": {
        "php": "^7.4.7",
        "auth0/auth0-php": "~7.0",
        "vlucas/phpdotenv": "^5.3"
    },
    "config": {
        "platform": {
            "php": "7.4.7"
        }
    },
    "scripts": {
        "deploy": "cd .. && ./bin/deploy.sh",
        "rollback": "cd .. && ./bin/rollback.sh"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.7",
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "YNotRadio\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "YNotRadio\\Tests\\": "tests/"
        }
    }
}
