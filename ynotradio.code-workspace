{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"editor.formatOnSave": true,
		"editor.tabSize": 4,
		"editor.insertSpaces": true,
		"files.insertFinalNewline": true,
		"files.trimTrailingWhitespace": true,
		"php.validate.enable": true,
		"php.suggest.basic": true,
		"phpsab.executablePathCS": "vendor/bin/phpcs",
		"phpsab.executablePathCBF": "vendor/bin/phpcbf",
		"phpsab.standard": "./src/phpcs.xml",
		"[php]": {
			"editor.defaultFormatter": "bmewburn.vscode-intelephense-client"
		},
		"sqltools.connections": [
			{
				"name": "Y-Not Radio DB",
				"driver": "MySQL",
				"server": "localhost",
				"port": 3306,
				"database": "ynot_site",
				"username": "ynot_sql_user",
				"password": "ynot_sql_pass"
			}
		]
	},
	"extensions": {
		"recommendations": [
			"bmewburn.vscode-intelephense-client",
			"xdebug.php-debug",
			"valeryanm.vscode-phpsab",
			"mrmlnc.vscode-apache",
			"mtxr.sqltools",
			"mtxr.sqltools-driver-mysql",
			"ms-azuretools.vscode-docker",
			"automatalabs.copilot-mcp"
		]
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Listen for Xdebug",
				"type": "php",
				"request": "launch",
				"port": 9003
			}
		]
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "Docker: Start Services",
				"type": "shell",
				"command": "docker-compose up -d",
				"problemMatcher": [],
				"group": {
					"kind": "build",
					"isDefault": true
				}
			},
			{
				"label": "Docker: Stop Services",
				"type": "shell",
				"command": "docker-compose down",
				"problemMatcher": []
			},
			{
				"label": "PHP Lint",
				"type": "shell",
				"command": "docker run --rm --volume ${workspaceFolder}:/app vfac/php7compatibility 7.4 ./src -d memory_limit=1G --extensions=php",
				"problemMatcher": []
			}
		]
	},
}
