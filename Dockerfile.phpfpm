# Pre-built PHP-FPM image with extensions and dependencies
# Avoids 10+ minute compilation time on every CI run
FROM php:7.4-fpm

# Install system dependencies and PHP extensions (the slow part)
RUN apt-get update \
    && apt-get install -y libpq-dev unzip curl \
    && docker-php-ext-install pdo pdo_pgsql pdo_mysql mysqli \
    && echo 'clear_env = no' >> /usr/local/etc/php-fpm.d/www.conf \
    && curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy composer files and install dependencies
COPY src/composer.json src/composer.lock ./
RUN composer install --no-interaction --no-dev --no-scripts --no-autoloader

# Copy source code (this layer changes more frequently)
COPY src/ ./

# Generate autoloader with full source available
RUN composer dump-autoload --no-interaction --optimize

# Default command
CMD ["php-fpm"]
