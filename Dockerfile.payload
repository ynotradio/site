FROM node:22-alpine

WORKDIR /app

# Install dependencies first for better caching
COPY package*.json ./
COPY yarn.lock* ./

RUN npm ci

# Copy application code
COPY . .

# Generate Payload types if possible
RUN npm run payload:generate-types || echo "Types generation skipped"

EXPOSE 3000

# Start with migrations then dev server
CMD ["sh", "-c", "npm run payload:migrate && npm run payload:dev"]
