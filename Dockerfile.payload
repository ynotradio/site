FROM node:22-alpine

WORKDIR /app

# Copy package files
COPY package.json ./
COPY yarn.lock ./

# Install dependencies with yarn
RUN yarn install --frozen-lockfile

# Copy application code
COPY . .

# Generate Payload types (if possible, don't fail if can't)
RUN yarn payload:generate-types || echo "⚠️  Type generation skipped (needs database)"

# Expose port
EXPOSE 3000

# Start Payload with migrations
CMD ["sh", "-c", "yarn payload:migrate && yarn payload:dev"]
