{
  "name": "ynotradio",
  "version": "1.0.0",
  "description": "----------------",
  "main": "index.js",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "setup:e2e": "./bin/setup-e2e-tests.sh",
    "pretest:e2e": "./bin/setup-e2e-tests.sh",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:docker": "docker run --rm --network host -v $(pwd):/app -w /app ynotradio-playwright",
    "test:e2e:docker:build": "docker build -f Dockerfile.playwright -t ynotradio-playwright .",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix --max-warnings=0",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:refresh": "./bin/refresh_local.sh",
    "payload:dev": "tsx payload/src/server.ts",
    "payload:generate-types": "tsx --import ./bin/preload-nextenv-fix.mjs node_modules/.bin/payload generate:types",
    "payload:generate-importmap": "tsx --import ./bin/preload-nextenv-fix.mjs node_modules/.bin/payload generate:importmap",
    "payload:migrate": "tsx --import ./bin/preload-nextenv-fix.mjs node_modules/.bin/payload migrate --forceAcceptWarning",
    "payload:migrate:create": "tsx --import ./bin/preload-nextenv-fix.mjs node_modules/.bin/payload migrate:create",
    "payload:migrate:status": "tsx --import ./bin/preload-nextenv-fix.mjs node_modules/.bin/payload migrate:status --forceAcceptWarning",
    "seed:mrm": "tsx --import ./bin/preload-nextenv-fix.mjs bin/seed-mrm.ts",
    "seed:mrm:fresh": "tsx --import ./bin/preload-nextenv-fix.mjs bin/seed-mrm-fresh.ts",
    "import:top11": "tsx --import ./bin/preload-nextenv-fix.mjs bin/migrations/importTop11.ts",
    "import:top11-votes": "tsx --import ./bin/preload-nextenv-fix.mjs bin/migrations/importTop11Votes.ts",
    "seed:payload": "tsx bin/seed-payload.ts",
    "seed:legacy": "./bin/seed-legacy.sh",
    "seed": "yarn seed:payload && yarn seed:legacy",
    "import:quick": "tsx bin/quick-import.ts",
    "import:incremental": "tsx bin/incremental-import.ts",
    "import:ondemand-songs": "tsx --import ./bin/preload-nextenv-fix.mjs bin/migrations/backfillOnDemandSongs.ts",
    "visual-diff": "tsx --import ./bin/preload-nextenv-fix.mjs bin/visual-diff/run.ts",
    "import:gap-report": "node --import ./bin/preload-nextenv-fix.mjs --import tsx bin/migrations/importGapReport.ts",
    "musicbrainz:match": "tsx --import ./bin/preload-nextenv-fix.mjs bin/musicbrainz-bulk-match.ts",
    "regenerate-slugs": "tsx --import ./bin/preload-nextenv-fix.mjs bin/regenerate-slugs.ts",
    "backfill:search-text-fields": "tsx --import ./bin/preload-nextenv-fix.mjs bin/backfill-search-text-fields.ts",
    "integrity:check:display-names": "tsx --import ./bin/preload-nextenv-fix.mjs bin/integrity-check-display-names.ts",
    "integrity:check:slugs": "tsx --import ./bin/preload-nextenv-fix.mjs bin/integrity-check-slugs.ts",
    "integrity:check:musicbrainz": "tsx --import ./bin/preload-nextenv-fix.mjs bin/integrity-check-musicbrainz.ts",
    "integrity:check:record-metadata": "tsx --import ./bin/preload-nextenv-fix.mjs bin/integrity-check-record-metadata.ts",
    "integrity:check:ondemand-source": "tsx --import ./bin/preload-nextenv-fix.mjs bin/integrity-check-ondemand-source.ts",
    "integrity:check:publish-status": "tsx --import ./bin/preload-nextenv-fix.mjs bin/integrity-check-publish-status.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "validate-stories": "node scripts/validate-stories.mjs",
    "validate:migrations": "bash scripts/validate-migrations.sh"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@benborla29/mcp-server-mysql": "^2.0.9",
    "@chromatic-com/storybook": "^5.3.0",
    "@netlify/plugin-nextjs": "^5.15.13",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-onboarding": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/nextjs-vite": "^10.5.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/jquery": "^4.0.1",
    "@types/node": "^22.20.1",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.2.18",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-next": "15.5.22",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jquery": "^4.0.0",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postgres": "^3.4.9",
    "prettier": "^3.9.6",
    "storybook": "^10.5.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@netlify/functions": "^5.3.0",
    "@payloadcms/db-postgres": "^3.88.0",
    "@payloadcms/next": "^3.88.0",
    "@payloadcms/plugin-cloud-storage": "^3.88.0",
    "@payloadcms/richtext-lexical": "^3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@types/dompurify": "^3.2.0",
    "@types/jsdom": "^28.0.3",
    "axios": "^1.16.1",
    "cloudinary": "^2.11.0",
    "dompurify": "^3.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "graphql": "^16.14.0",
    "mysql2": "^3.22.5",
    "next": "^16.3.0",
    "payload": "^3.88.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "serverless-http": "^4.0.0",
    "sharp": "^0.35.4"
  },
  "prettier": {
    "semi": true,
    "printWidth": 100,
    "bracketSpacing": true,
    "singleQuote": true,
    "tabWidth": 2
  },
  "resolutions": {
    "fast-uri": "^3.1.2",
    "picomatch": "^2.3.2",
    "flatted": "^3.4.2",
    "immutable": "^4.3.8",
    "rollup": "^4.59.0",
    "@modelcontextprotocol/sdk": "^1.26.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
