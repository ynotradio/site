{
  "name": "ynotradio",
  "version": "1.0.0",
  "description": "----------------",
  "main": "index.js",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "setup:e2e": "./bin/setup-e2e-tests.sh",
    "pretest:e2e": "./bin/setup-e2e-tests.sh",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:docker": "docker run --rm --network host -v $(pwd):/app -w /app ynotradio-playwright",
    "test:e2e:docker:build": "docker build -f Dockerfile.playwright -t ynotradio-playwright .",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix --max-warnings=0",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:refresh": "./bin/refresh_local.sh",
    "payload:dev": "tsx payload/src/server.ts",
    "payload:generate-types": "tsx node_modules/.bin/payload generate:types",
    "payload:generate-importmap": "tsx node_modules/.bin/payload generate:importmap",
    "payload:migrate": "tsx node_modules/.bin/payload migrate --forceAcceptWarning",
    "payload:migrate:create": "tsx node_modules/.bin/payload migrate:create",
    "payload:migrate:status": "tsx node_modules/.bin/payload migrate:status",
    "seed:payload": "tsx bin/seed-payload.ts",
    "seed:legacy": "./bin/seed-legacy.sh",
    "seed": "yarn seed:payload && yarn seed:legacy",
    "import:quick": "tsx bin/quick-import.ts",
    "import:incremental": "tsx bin/incremental-import.ts",
    "import:gap-report": "tsx bin/migrations/importGapReport.ts",
    "neon-db:copy": "tsx bin/copy-neon-db.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "validate-stories": "node scripts/validate-stories.mjs"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@benborla29/mcp-server-mysql": "^2.0.8",
    "@chromatic-com/storybook": "^5.0.0",
    "@netlify/plugin-nextjs": "^5.15.7",
    "@playwright/test": "^1.58.0",
    "@storybook/addon-a11y": "^10.2.1",
    "@storybook/addon-docs": "^10.2.1",
    "@storybook/addon-onboarding": "^10.2.1",
    "@storybook/addon-vitest": "^10.2.1",
    "@storybook/nextjs-vite": "^10.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.7",
    "@types/react": "19.2.9",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-next": "15.5.9",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "postgres": "^3.4.8",
    "prettier": "^3.8.1",
    "storybook": "^10.2.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@netlify/functions": "^5.1.2",
    "@payloadcms/db-postgres": "^3.69.0",
    "@payloadcms/next": "^3.69.0",
    "@payloadcms/plugin-cloud-storage": "^3.69.0",
    "@payloadcms/richtext-lexical": "^3.69.0",
    "@payloadcms/ui": "3.69.0",
    "@types/dompurify": "^3.2.0",
    "@types/jsdom": "^27.0.0",
    "axios": "^1.13.4",
    "cloudinary": "^2.9.0",
    "dompurify": "^3.3.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "graphql": "^16.12.0",
    "mysql2": "^3.16.1",
    "next": "^15.5.9",
    "payload": "^3.69.0",
    "pg": "^8.17.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "serverless-http": "^4.0.0",
    "sharp": "^0.34.5"
  },
  "prettier": {
    "semi": true,
    "printWidth": 100,
    "bracketSpacing": true,
    "singleQuote": true,
    "tabWidth": 2
  },
  "lint-staged": {
    "!(*.test).{ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0 --ignore-pattern 'bin/check-test-story-files.ts' --ignore-pattern '.storybook/*'"
    ],
    "*.test.{ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
