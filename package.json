{
  "name": "ynotradio",
  "version": "1.0.0",
  "description": "----------------",
  "main": "index.js",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix --max-warnings=0",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:refresh": "./bin/refresh_local.sh",
    "payload:dev": "tsx payload/src/server.ts",
    "payload:generate-types": "tsx node_modules/.bin/payload generate:types",
    "payload:generate-importmap": "tsx node_modules/.bin/payload generate:importmap",
    "payload:migrate": "tsx node_modules/.bin/payload migrate --forceAcceptWarning",
    "payload:migrate:create": "tsx node_modules/.bin/payload migrate:create",
    "payload:migrate:status": "tsx node_modules/.bin/payload migrate:status",
    "seed:payload": "tsx bin/seed-payload.ts",
    "seed:legacy": "./bin/seed-legacy.sh",
    "seed": "yarn seed:payload && yarn seed:legacy",
    "import:quick": "tsx bin/quick-import.ts",
    "neon-db:copy": "tsx bin/copy-neon-db.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@benborla29/mcp-server-mysql": "^2.0.7",
    "@chromatic-com/storybook": "^4.1.3",
    "@netlify/plugin-nextjs": "^5.15.4",
    "@storybook/addon-a11y": "^10.1.11",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/addon-onboarding": "^10.1.11",
    "@storybook/addon-vitest": "^10.1.11",
    "@storybook/nextjs-vite": "^10.1.11",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.5",
    "@types/react": "19.2.8",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/browser-playwright": "^4.0.15",
    "@vitest/coverage-v8": "^4.0.15",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-plugin-import": "^2.31.0",
    "jsdom": "^27.4.0",
    "playwright": "^1.57.0",
    "postgres": "^3.4.8",
    "prettier": "^3.5",
    "storybook": "^10.1.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "@netlify/functions": "^5.1.2",
    "@payloadcms/db-postgres": "^3.69.0",
    "@payloadcms/next": "^3.69.0",
    "@payloadcms/plugin-cloud-storage": "^3.69.0",
    "@payloadcms/richtext-lexical": "^3.69.0",
    "@types/dompurify": "^3.2.0",
    "@types/jsdom": "^27.0.0",
    "axios": "^1.13.2",
    "cloudinary": "^2.8.0",
    "dompurify": "^3.3.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "graphql": "^16.12.0",
    "mysql2": "^3.16.0",
    "next": "^15.5.9",
    "payload": "^3.69.0",
    "pg": "^8.16.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "serverless-http": "^4.0.0",
    "sharp": "^0.34.5"
  },
  "prettier": {
    "semi": true,
    "printWidth": 100,
    "bracketSpacing": true,
    "singleQuote": true,
    "tabWidth": 2
  }
}
